# Keep generated source, module metadata, and scripts byte-stable across platforms.
*.go text eol=lf
*.sh text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Preserve upstream fixtures exactly. Some are non-UTF-8 or binary.
testdata/** -text

# Keep generated schemas and fixtures out of GitHub language statistics.
**/zz_generated_*.go linguist-generated=true
schema/** linguist-vendored=true
testdata/corpus/** linguist-vendored=true
