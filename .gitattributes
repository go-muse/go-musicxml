# Keep generated source, module metadata, and scripts byte-stable across platforms.
*.go text eol=lf
*.sh text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Preserve upstream fixtures exactly. Some are non-UTF-8 or binary.
testdata/** -text

# Keep generated schemas and fixtures out of GitHub language statistics.
**/zz_generated_*.go linguist-generated=true
schema/** linguist-vendored=true
testdata/corpus/** linguist-vendored=true

# Preserve exact planning input hashes across Git checkout line-ending policies.
# The reviewed data is large; collapse it in GitHub's default diff view.
docs/validation/plan/*.json text eol=lf linguist-generated=true
# The published deferred source has a checked byte hash on every platform.
docs/validation/deferred-inventory.md text eol=lf

# Runtime dictionary assets are generated byte-identical copies of pinned data.
internal/dictionarydata/data/** -text linguist-generated=true
# The pinned upstream sounds.xml retains CRLF and literal trailing spaces.
internal/dictionarydata/data/musicxml-4.0/sounds.xml -whitespace

# Bundled official MusicXML DTD modules keep their upstream CRLF bytes;
# bundled_dtd.go pins each file's SHA-256.
schema/musicxml-4.0/*.dtd -text
schema/musicxml-4.0/*.mod -text
schema/musicxml-4.0/*.ent -text
