    },
    {
      "id": "XSD10-SEM-XSI-LOCATION",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Schema-instance location hints",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#xsi_schemaLocation",
      "applicability_preassessment": "source",
      "conditions": "xsi:schemaLocation or xsi:noNamespaceSchemaLocation is supplied",
      "neutral_rule": "Validate standard schema-instance attribute lexical/list shape; location is a hint; no mandatory external fetching"
    },
    {
      "id": "XSD10-SEM-XSI-ATTRS",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Standard schema-instance attribute exception",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-complex-type",
      "applicability_preassessment": "source",
      "conditions": "schema-instance attribute supplied on an assessed element",
      "neutral_rule": "Allow only standard xsi:type, xsi:nil, xsi:schemaLocation, xsi:noNamespaceSchemaLocation subject to their own constraints; do not reject merely because absent from MusicXML XSD"
    }
