  "semantic_rules": [
    {
      "id": "XSD10-SEM-NAME",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Expanded-name matching",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-elt",
      "applicability_preassessment": "both",
      "conditions": "element_or_attribute_assessed",
      "neutral_rule": "QName(instance)=expanded_name(declaration)"
    },
    {
      "id": "XSD10-SEM-ORDER",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Sequence order",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-model-group",
      "applicability_preassessment": "both",
      "conditions": "sequence_occurs",
      "neutral_rule": "L(sequence)=concatenate(L(child_1),...,L(child_n))"
    },
    {
      "id": "XSD10-SEM-CHOICE",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Choice alternatives",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-model-group",
      "applicability_preassessment": "both",
      "conditions": "choice_occurs",
      "neutral_rule": "L(choice)=union(L(child_1),...,L(child_n)); nullable branches remain nullable"
    },
    {
      "id": "XSD10-SEM-OCCURS",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Particle bounds",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-particle",
      "applicability_preassessment": "both",
      "conditions": "particle_assessed",
      "neutral_rule": "L(particle)=repeat(L(term),minOccurs,maxOccurs); omitted bounds=1"
    },
    {
      "id": "XSD10-SEM-TYPE",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Declared type assessment",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-type",
      "applicability_preassessment": "both",
      "conditions": "declaration_assessed",
      "neutral_rule": "value/content satisfies resolved type"
    },
    {
      "id": "XSD10-SEM-ATTRUSE",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Attribute presence",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-complex-type",
      "applicability_preassessment": "both",
      "conditions": "attribute_use_assessed",
      "neutral_rule": "required => present; optional => zero_or_one; omitted use=optional"
    },
    {
      "id": "XSD10-SEM-DEFAULT",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Schema default",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-attribute",
      "applicability_preassessment": "both",
      "conditions": "attribute_absent_with_default",
      "neutral_rule": "effective_value=typed(default); physical_absence remains provenance"
    },
    {
      "id": "XSD10-SEM-FIXED",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Fixed value",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-attribute",
      "applicability_preassessment": "both",
      "conditions": "attribute_present_with_fixed",
      "neutral_rule": "typed(actual)=typed(fixed); absent optional fixed contributes defaulted value"
    },
    {
      "id": "XSD10-SEM-CLOSED",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Closed content",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-complex-type",
      "applicability_preassessment": "both",
      "conditions": "complex_type_assessed",
      "neutral_rule": "only declared attributes and child grammar; standard xsi exceptions apply"
    },
    {
      "id": "XSD10-SEM-TEXT",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Text-content category",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-complex-type",
      "applicability_preassessment": "both",
      "conditions": "complex_type_assessed",
      "neutral_rule": "simple=>typed text/no children; element_only=>XML whitespace between children; empty=>no character/element children"
    },
    {
      "id": "XSD10-SEM-NIL",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Nil legality",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-elt",
      "applicability_preassessment": "source",
      "conditions": "xsi:nil supplied",
      "neutral_rule": "nillable=false when absent; xsi:nil=true disallowed; xsi:nil lexical boolean checked"
    },
    {
      "id": "XSD10-SEM-XSI",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Dynamic type assessment",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-elt",
      "applicability_preassessment": "source",
      "conditions": "xsi:type supplied",
      "neutral_rule": "QName resolves; dynamic type validly derived; block constraints honored"
    },
    {
      "id": "XSD10-SEM-BLOCK",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Blocked derivation/substitution",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-elt",
      "applicability_preassessment": "source",
      "conditions": "dynamic_type_or_substitution_used",
      "neutral_rule": "reject blocked derivation/substitution path"
    },
    {
      "id": "XSD10-SEM-FINAL",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Final derivation declaration",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#Element_Declaration_details",
      "applicability_preassessment": "source",
      "conditions": "schema_derivation_or_substitution_assembly",
      "neutral_rule": "final constrains schema derivation/substitution membership, not an unconditional ban on xsi:type"
    },
    {
      "id": "XSD10-SEM-ENUM",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Typed enumeration",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#rf-enumeration",
      "applicability_preassessment": "both",
      "conditions": "enumeration_facet_assessed",
      "neutral_rule": "typed(value) in typed(enumeration_values); same-restriction values are alternatives"
    },
    {
      "id": "XSD10-SEM-PATTERN",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "XSD regular expression",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#regexs",
      "applicability_preassessment": "source",
      "conditions": "pattern_facet_assessed",
      "neutral_rule": "XSD10_REGEX_FULL_MATCH(normalized_lexical,pattern); XML Schema Unicode escapes/classes"
    },
    {
      "id": "XSD10-SEM-BOUND",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Numeric bounds",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#rf-minInclusive",
      "applicability_preassessment": "both",
      "conditions": "bound_facet_assessed",
      "neutral_rule": "typed(value) >=,>,<=,< typed(bound) according to facet"
    },
    {
      "id": "XSD10-SEM-LENGTH",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Character length",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#rf-minLength",
      "applicability_preassessment": "both",
      "conditions": "string_minLength_assessed",
      "neutral_rule": "count_XML_characters(value)>=minLength; not UTF-8 bytes"
    },
    {
      "id": "XSD10-SEM-RESTRICT",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Restriction inheritance",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#derivation-by-restriction",
      "applicability_preassessment": "both",
      "conditions": "restricted_type_assessed",
      "neutral_rule": "base validity AND new facets; preserve per-derivation layers"
    },
    {
      "id": "XSD10-SEM-EXTEND",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Extension inheritance",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#Complex_Type_Definition_details",
      "applicability_preassessment": "both",
      "conditions": "extended_type_assessed",
      "neutral_rule": "inherit base content/attributes; append extension content and attribute uses"
    },
    {
      "id": "XSD10-SEM-UNION",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Union member alternatives",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#dt-union",
      "applicability_preassessment": "both",
      "conditions": "union_type_assessed",
      "neutral_rule": "exists member valid; member-specific whitespace and value space; declaration member order retained"
    },
    {
      "id": "XSD10-SEM-WS",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Datatype whitespace",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#rf-whiteSpace",
      "applicability_preassessment": "source",
      "conditions": "simple_type_assessed",
      "neutral_rule": "preserve|replace|collapse per datatype; union uses successful member"
    },
    {
      "id": "XSD10-SEM-LEXICAL",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Datatype lexical space",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/#cvc-datatype-valid",
      "applicability_preassessment": "source",
      "conditions": "simple_value_assessed",
      "neutral_rule": "lexical form valid before value-space facets"
    },
    {
      "id": "XSD10-SEM-ID",
      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "ID uniqueness",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#cvc-id",
      "applicability_preassessment": "both",
