    "scope": "six official XSD files, exact supplied dependency modules, five roots; XSD 1.0 semantics; no DTD/XSLT or prose norms",
    "id_policy": "MX40-XSD- + first 16 hex SHA256(file + | + stable XPath); properties append @name. IDs identify source occurrences, not runtime error-code architecture.",
    "total_schema_occurrences": 2939,
    "total_explicit_attribute_occurrences": 3958,
