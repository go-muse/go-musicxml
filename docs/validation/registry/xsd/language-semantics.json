      "version": "XSD-1.0-Second-Edition-2004",
      "source_kind": "XSD_language",
      "origin": "normative_language_semantics_not_MusicXML_occurrence",
      "description": "Reference substitution",
      "source_url": "https://www.w3.org/TR/2004/REC-xmlschema-1-20041028/#Model_Group_Definition_details",
